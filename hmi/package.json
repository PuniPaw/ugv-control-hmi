{
  "name": "ugvc-hmi",
  "private": true,
  "version": "0.1.0",
  "description": "UGVC 관제 HMI (Vue 3 + TypeScript + Leaflet). IF-03(GW WebSocket)을 받아 지도와 상태 패널을 그린다.",
  "type": "module",
  "scripts": {
